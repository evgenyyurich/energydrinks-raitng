# Все переменные необязательны; значения ниже — по умолчанию (если не указано иное).

# development | production. В production: cookie с флагом Secure и раздача собранного фронтенда из dist/.
NODE_ENV=development
# Порт и адрес. За Caddy слушаем только localhost.
PORT=3000
HOST=127.0.0.1
# Файл SQLite (по умолчанию server/data/app.db). Эту папку нужно бэкапить.
DB_PATH=server/data/app.db
# Папка с аватарками, раздаётся как /uploads/... (по умолчанию server/uploads).
UPLOADS_DIR=server/uploads
# 1 — доверять X-Forwarded-For (включать только за Caddy/nginx), иначе лимиты считаются по адресу сокета.
TRUST_PROXY=0
# Доп. разрешённые Origin через запятую (если нужны, кроме совпадающего с Host).
ALLOWED_ORIGINS=
